name: Multi-Region Kubernetes Deployment

on:
  push:
    branches:
      - main
      - dev

jobs:

  build:
    name: Build Docker Image
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Build Docker Image
        run: |
          docker build -t pathnex-web-app:${{ github.sha }} .


  push:
    name: Push Docker Image
    runs-on: ubuntu-latest
    needs: build

    steps:
      - name: Login to Container Registry
        run: |
          echo "${{ secrets.REGISTRY_PASSWORD }}" |
          docker login \
          -u "${{ secrets.REGISTRY_USER }}" \
          --password-stdin

      - name: Push Image
        run: |
          docker tag pathnex-web-app:${{ github.sha }} \
          ${{ secrets.REGISTRY_URL }}/pathnex-web-app:${{ github.sha }}

          docker push \
          ${{ secrets.REGISTRY_URL }}/pathnex-web-app:${{ github.sha }}


  deploy:
    name: Deploy Kubernetes
    runs-on: ubuntu-latest
    needs: push

    steps:

      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Configure Kubernetes
        uses: azure/setup-kubectl@v4

      - name: Deploy Multi Region
        run: |

          if [ "${{ github.ref_name }}" == "main" ]; then

            echo "Deploying Production - US East"

            kubectl \
            --context=us-east \
            apply \
            -f kubernetes/prod-deployment.yaml

          else

            echo "Deploying Development - US West"

            kubectl \
            --context=us-west \
            apply \
            -f kubernetes/dev-deployment.yaml

          fi


